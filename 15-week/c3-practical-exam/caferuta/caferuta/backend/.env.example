# Copia este archivo como .env y cambia los valores. NUNCA subas .env a Git.

# Puerto donde escucha la API
PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (usuario:clave@host:puerto/base)
DATABASE_URL=postgres://caferuta:cambia-esta-clave@localhost:5432/caferuta

# Secreto para firmar los JWT. Genera uno largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# Orígenes del frontend autorizados por CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173
